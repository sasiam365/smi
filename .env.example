# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Testing Configuration for cPanel Subdomain
APP_ENV="testing"
APP_URL="https://prottoyonbd.maltimarket.com"
FRONTEND_URL="https://prottoyonbd.maltimarket.com"
QR_VERIFY_BASE_URL="https://prottoyonbd.maltimarket.com/verify"

# Optional PottoyonBD runtime configuration
POTTOYON_SESSION_SECRET=""
POTTOYON_DB_PATH="data/pottoyonbd_testing.sqlite"
POTTOYON_STORAGE_DIR="storage_testing"
POTTOYON_VERIFY_RATE_LIMIT="60"


